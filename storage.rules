rules_version = '2';

// Comment photos live at lists/{listId}/comments/{commentId}.jpg. Access mirrors the list:
// only its members can see or add photos, and only its creator can delete them. These rules
// read the list from Firestore, so Firebase asks once to allow Storage to read Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    function listData(listId) {
      return firestore.get(/databases/(default)/documents/lists/$(listId)).data;
    }

    function isMember(listId) {
      return request.auth != null && request.auth.uid in listData(listId).memberIds;
    }

    match /lists/{listId}/comments/{fileName} {
      allow read: if isMember(listId);

      // New uploads only (no overwriting), JPEG, under 5 MB, named <commentId>.jpg.
      allow create: if isMember(listId)
        && fileName.matches('[A-Za-z0-9]+\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == listData(listId).ownerId;
    }
  }
}

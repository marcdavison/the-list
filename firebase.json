{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting/public",
    "appAssociation": "NONE",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/l/**", "destination": "/l/index.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/**",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      },
      {
        "source": "/l/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
